# ==============================================================================
# GodsEye Frontend (Vercel) Environment Variables
# ==============================================================================

# Public API URL of your deployed Express backend (with /api suffix)
# Example: https://godseye-backend.onrender.com/api or https://api.godseye.org/api
VITE_API_URL=http://localhost:5000/api

# Optional: Uploads base URL if served independently or via dedicated CDN/S3
# If left unset, it automatically derives from VITE_API_URL (/uploads)
# Example: https://godseye-backend.onrender.com/uploads
# VITE_UPLOADS_URL=http://localhost:5000/uploads
