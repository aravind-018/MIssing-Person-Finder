# ==============================================================================
# GodsEye Backend API Environment Variables
# (Deploy on Render, Railway, Fly.io, or VPS)
# ==============================================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
# Example: mongodb+srv://app_user:YourStrongPassword@cluster0.abcde.mongodb.net/godseye?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/godseye

# Strong random secret used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=replace_with_a_long_secure_random_hex_or_string

# External AI Microservice URL (FastAPI/InsightFace process)
# In development: http://localhost:8000
# In production: https://godseye-ai.onrender.com
AI_SERVICE_URL=http://localhost:8000

# Allowed CORS origins (comma-separated). Set to your deployed Vercel domain!
# Example: https://godseye.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://godseye.vercel.app,http://localhost:5173,http://localhost:3000

# Directory for file uploads (defaults to ./uploads)
# In production on persistent Docker/Linux disk, specify the mount path e.g. /app/uploads
UPLOADS_DIR=uploads

# Optional AI Tunables
FACE_MATCH_THRESHOLD=0.45
VIDEO_FRAME_INTERVAL=5
