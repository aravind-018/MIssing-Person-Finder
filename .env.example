# ==============================================================================
# GodsEye — Deployment Environment Variable Guide
# ==============================================================================
#
# 1. FRONTEND (Vercel Project Settings > Environment Variables):
# -------------------------------------------------------------
# VITE_API_URL=https://<your-backend-domain>/api
# VITE_UPLOADS_URL=https://<your-backend-domain>/uploads
#
# 2. BACKEND API (Render / Railway / VPS Environment Variables):
# -------------------------------------------------------------
# PORT=5000
# NODE_ENV=production
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/godseye?retryWrites=true&w=majority
# JWT_SECRET=<a-long-random-string>
# AI_SERVICE_URL=https://<your-ai-service-domain>
# ALLOWED_ORIGINS=https://<your-vercel-domain>.vercel.app
# UPLOADS_DIR=uploads
#
# 3. AI SERVICE (FastAPI / InsightFace Container):
# -------------------------------------------------------------
# PORT=8000
#
