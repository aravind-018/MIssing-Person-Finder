{
  "name": "godseye",
  "productName": "GodsEye",
  "version": "1.0.0",
  "description": "GodsEye AI-Based Missing Person Identification System",
  "author": "Aravind C",
  "private": true,
  "main": "electron/main.js",

  "scripts": {
    "electron": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },

  "dependencies": {
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "react-chartjs-2": "^5.3.1",
    "react-icons": "^5.7.0",
    "wait-on": "^9.1.0"
  },

  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },

  "build": {
    "appId": "com.godseye.desktop",
    "productName": "GodsEye",

    "directories": {
      "output": "release"
    },

    "files": [
      "electron/**/*",
      "client/**/*",
      "server/**/*",
      "ai-services/**/*",
      "package.json"
    ],

    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "client",
        "to": "client"
      },
      {
        "from": "ai-services",
        "to": "ai-services"
      }
    ],

    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}